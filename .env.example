# === LLM Configuration ===
LLM_PROVIDER=local                          # "local" or "remote"

# Chat model
LLM_BASE_URL=http://192.168.137.1:1234/v1
LLM_API_KEY=lm-studio
LLM_CHAT_MODEL=ibm/granite-4-h-tiny

# Embedding model (can be same or different LM Studio instance)
EMBED_BASE_URL=http://192.168.137.1:1234/v1
EMBED_API_KEY=lm-studio
EMBED_MODEL=text-embedding-nomic-embed-text-v2-moe
EMBED_DIMENSION=768

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pathfinder123

# === Qdrant ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# === Data ===
DATA_DIR=./Data

# === Agent ===
TOP_N_RESULTS=10
EMBED_BATCH_SIZE=32
