# === LLM Configuration ===
LLM_PROVIDER=local                          # "local" or "remote"

# Chat model configuration
# - For LM Studio: use http://localhost:1234/v1 and API key 'lm-studio' (or any string)
# - For Ollama: use http://localhost:11434/v1 and API key 'ollama' (or any string)
# - For OpenAI: use https://api.openai.com/v1 and your actual OpenAI API key
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_CHAT_MODEL=ibm/granite-4-h-tiny

# Embedding model configuration
# - Make sure the model matches the dimension (e.g., 768 for nomic-embed-text)
EMBED_BASE_URL=http://localhost:1234/v1
EMBED_API_KEY=lm-studio
EMBED_MODEL=text-embedding-nomic-embed-text-v2-moe
EMBED_DIMENSION=768

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pathfinder123

# === Qdrant ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# === Data ===
DATA_DIR=./Data

# === Agent ===
TOP_N_RESULTS=10
EMBED_BATCH_SIZE=32
