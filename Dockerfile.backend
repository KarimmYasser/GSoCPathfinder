FROM python:3.12-slim

WORKDIR /app

# Install uv for fast dependency management
RUN pip install uv

# Install dependencies
COPY pyproject.toml .
# We use system python to avoid virtualenv inside docker
RUN uv pip install --system -r pyproject.toml

# Copy source code
COPY ./src /app/src

# Copy .env
COPY .env .env

# Expose port
EXPOSE 8000

# Start server
CMD ["uvicorn", "src.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
